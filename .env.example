# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL (used to build the payment callback URL)
# NEXT_PUBLIC_SITE_URL=https://cafedefelore.ir

# ─── Payment gateway ───────────────────────────────────────────────
# Leave ZARINPAL_MERCHANT_ID empty to use the built-in simulated gateway ("Felore Pay").
# Set it to your ZarinPal merchant id to accept real payments.
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=true

# ─── Admin panel (/admin) ───────────────────────────────────────────
# ADMIN_PASSWORD=change-me
